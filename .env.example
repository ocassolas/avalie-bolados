# Copie para .env.local e preencha. Sem estas duas variáveis o app roda em MODO DEMONSTRAÇÃO.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (a chave anon antiga também funciona: NEXT_PUBLIC_SUPABASE_ANON_KEY)

# URL pública do app (links de e-mail). Na Vercel é detectada sozinha.
NEXT_PUBLIC_SITE_URL=https://avaliebolados.com.br

# Opcional: contato exibido na Política de Privacidade
NEXT_PUBLIC_PRIVACY_CONTACT=
